{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpgai.dev/schemas/fpgai.package.v1.schema.json",
  "title": "FPGAI Research Package Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "package",
    "usage",
    "license",
    "compatibility",
    "capabilities",
    "entrypoints",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "fpgai.package/v1"
    },
    "package": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "asset_type",
        "provider",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "asset_type": {
          "enum": [
            "model",
            "operator",
            "implementation",
            "accelerator",
            "board",
            "backend",
            "optimizer",
            "loss",
            "dataset",
            "memory_policy",
            "transport",
            "runtime_reference",
            "validation",
            "reporter",
            "benchmark",
            "system_block",
            "adapter"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": [
        "platform_scope",
        "permitted_uses",
        "production_path"
      ],
      "properties": {
        "platform_scope": {
          "const": "research"
        },
        "permitted_uses": {
          "type": "array",
          "items": {
            "enum": [
              "research",
              "experimentation",
              "validation",
              "benchmarking",
              "education"
            ]
          },
          "uniqueItems": true
        },
        "production_path": {
          "const": "morfics"
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "enum": [
            "open_source",
            "source_available",
            "research_only",
            "commercial",
            "proprietary",
            "internal"
          ]
        },
        "identifier": {
          "type": "string"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "fpgai_contract"
      ],
      "properties": {
        "fpgai_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object"
    },
    "entrypoints": {
      "type": "object"
    },
    "interfaces": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "version"
        ],
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "declared_level"
      ],
      "properties": {
        "declared_level": {
          "enum": [
            "unvalidated",
            "reference_tested",
            "c_simulation_validated",
            "rtl_simulation_validated",
            "hls_synthesized",
            "vivado_synthesized",
            "implemented",
            "bitstream_generated",
            "hardware_tested",
            "reproducible",
            "certified_external"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
